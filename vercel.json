{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/check-training-media.mjs && npx @11ty/eleventy",
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/dc-air-training(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/training-login.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/api/training-(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.athlos.fi" }], "destination": "https://athlos.fi/:path*", "permanent": true },

    { "source": "/downloads",                          "destination": "/products/",                "statusCode": 301 },
    { "source": "/downloads/",                         "destination": "/products/",                "statusCode": 301 },

    { "source": "/ufs",                               "destination": "/products/ufs.html",        "statusCode": 301 },
    { "source": "/ufs/",                              "destination": "/products/ufs.html",        "statusCode": 301 },
    { "source": "/industrial-ip67-tdi",               "destination": "/products/ufs-ip67.html",   "statusCode": 301 },
    { "source": "/industrial-ip67-tdi/",              "destination": "/products/ufs-ip67.html",   "statusCode": 301 },
    { "source": "/wireless-intraoral-sensor",         "destination": "/products/wios.html",       "statusCode": 301 },
    { "source": "/wireless-intraoral-sensor/",        "destination": "/products/wios.html",       "statusCode": 301 },
    { "source": "/applications-and-market-segments",  "destination": "/applications.html",        "statusCode": 301 },
    { "source": "/applications-and-market-segments/", "destination": "/applications.html",        "statusCode": 301 },
    { "source": "/athlos",                            "destination": "/about.html",               "statusCode": 301 },
    { "source": "/athlos/",                           "destination": "/about.html",               "statusCode": 301 },
    { "source": "/contact",                           "destination": "/contact.html",             "statusCode": 301 },
    { "source": "/contact/",                          "destination": "/contact.html",             "statusCode": 301 },
    { "source": "/privacy-policy",                    "destination": "/privacy.html",             "statusCode": 301 },
    { "source": "/privacy-policy/",                   "destination": "/privacy.html",             "statusCode": 301 },

    { "source": "/products/solutions.html",            "destination": "/products/software.html",   "statusCode": 301 },
    { "source": "/products/solutions",                 "destination": "/products/software.html",   "statusCode": 301 },

    { "source": "/cefla",                              "destination": "/cefla.html",               "statusCode": 301 },
    { "source": "/cefla/",                             "destination": "/cefla.html",               "statusCode": 301 },

    { "source": "/de/ufs",                               "destination": "/de/products/ufs.html",        "statusCode": 301 },
    { "source": "/de/ufs/",                              "destination": "/de/products/ufs.html",        "statusCode": 301 },
    { "source": "/de/industrial-ip67-tdi",               "destination": "/de/products/ufs-ip67.html",   "statusCode": 301 },
    { "source": "/de/industrial-ip67-tdi/",              "destination": "/de/products/ufs-ip67.html",   "statusCode": 301 },
    { "source": "/de/wireless-intraoral-sensor",         "destination": "/de/products/wios.html",       "statusCode": 301 },
    { "source": "/de/wireless-intraoral-sensor/",        "destination": "/de/products/wios.html",       "statusCode": 301 },
    { "source": "/de/applications-and-market-segments",  "destination": "/de/applications.html",        "statusCode": 301 },
    { "source": "/de/applications-and-market-segments/", "destination": "/de/applications.html",        "statusCode": 301 },
    { "source": "/de/athlos",                            "destination": "/de/about.html",               "statusCode": 301 },
    { "source": "/de/athlos/",                           "destination": "/de/about.html",               "statusCode": 301 },
    { "source": "/de/contact",                           "destination": "/de/contact.html",             "statusCode": 301 },
