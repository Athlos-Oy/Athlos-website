    { "source": "/es/applications-and-market-segments/", "destination": "/es/applications.html",        "statusCode": 301 },
    { "source": "/es/athlos",                            "destination": "/es/about.html",               "statusCode": 301 },
    { "source": "/es/athlos/",                           "destination": "/es/about.html",               "statusCode": 301 },
    { "source": "/es/contact",                           "destination": "/es/contact.html",             "statusCode": 301 },
    { "source": "/es/contact/",                          "destination": "/es/contact.html",             "statusCode": 301 },
    { "source": "/es/privacy-policy",                    "destination": "/es/privacy.html",             "statusCode": 301 },
    { "source": "/es/privacy-policy/",                   "destination": "/es/privacy.html",             "statusCode": 301 }
  ]
}
