    { "source": "/it/industrial-ip67-tdi",               "destination": "/it/products/ufs-ip67.html",   "statusCode": 301 },
    { "source": "/it/industrial-ip67-tdi/",              "destination": "/it/products/ufs-ip67.html",   "statusCode": 301 },
    { "source": "/it/wireless-intraoral-sensor",         "destination": "/it/products/wios.html",       "statusCode": 301 },
