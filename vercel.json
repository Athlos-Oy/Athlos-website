    { "source": "/it/athlos",                            "destination": "/it/about.html",               "statusCode": 301 },
    { "source": "/it/athlos/",                           "destination": "/it/about.html",               "statusCode": 301 },
    { "source": "/it/contact",                           "destination": "/it/contact.html",             "statusCode": 301 },
    { "source": "/it/contact/",                          "destination": "/it/contact.html",             "statusCode": 301 },
