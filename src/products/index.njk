            <span class="panel-link">{{ "pages.productsIndex.cards.software.link" | t }} →</span>
          </div>
        </a>

      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="categories-section">
      <div class="container">
        <p class="section-eyebrow reveal">{{ "pages.productsIndex.categories.eyebrow" | t }}</p>
        <h2 class="section-headline reveal" style="max-width:560px">{{ "pages.productsIndex.categories.headline" | t }}</h2>
        <div class="categories-grid">

          <div class="category-block reveal">
            <span class="category-label">{{ "pages.productsIndex.categories.dental.label" | t }}</span>
