            <ul class="category-products">
              <li><a href="wios.html">{{ "pages.productsIndex.categories.dental.items.wios" | t }}</a></li>
              <li><a href="ufs.html">{{ "pages.productsIndex.categories.dental.items.ufs" | t }}</a></li>
            </ul>
          </div>

          <div class="category-block reveal" data-delay="80">
            <span class="category-label">{{ "pages.productsIndex.categories.industrial.label" | t }}</span>
            <h3 class="category-name">{{ "pages.productsIndex.categories.industrial.name" | t }}</h3>
            <ul class="category-products">
              <li><a href="ufs-ip67.html">{{ "pages.productsIndex.categories.industrial.items.ufsIp67" | t }}</a></li>
              <li><a href="ufs.html">{{ "pages.productsIndex.categories.industrial.items.ufs" | t }}</a></li>
            </ul>
          </div>

          <div class="category-block reveal" data-delay="160">
            <span class="category-label">{{ "pages.productsIndex.categories.services.label" | t }}</span>
            <h3 class="category-name">{{ "pages.productsIndex.categories.services.name" | t }}</h3>
            <ul class="category-products">
              <li><a href="software.html">{{ "pages.productsIndex.categories.services.items.software" | t }}</a></li>
              <li><a href="software.html">{{ "pages.productsIndex.categories.services.items.twain" | t }}</a></li>
              <li><a href="software.html">{{ "pages.productsIndex.categories.services.items.filters" | t }}</a></li>
              <li><a href="manufacturing.html">{{ "pages.productsIndex.categories.services.items.manufacturing" | t }}</a></li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="product-cta" id="contact">
      <div class="container">
        <div class="product-cta-inner">
          <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.productsIndex.cta.eyebrow" | t }}</p>
          <h2 class="reveal">{{ "pages.productsIndex.cta.headline" | t }}</h2>
          <p class="reveal">{{ "pages.productsIndex.cta.body" | t }}</p>
          <div class="reveal">
            <a href="../contact.html" class="btn btn-primary btn-large">{{ "pages.productsIndex.cta.button" | t }}</a>
          </div>
        </div>
      </div>
    </section>

    <p style="max-width:1280px;margin:0 auto;padding:0 clamp(1.5rem,5vw,5rem) clamp(2rem,4vw,3rem);font-size:0.75rem;font-weight:400;letter-spacing:0.04em;color:#8C959B;text-align:center;">{{ "pages.productsIndex.lastUpdated.label" | t }} <time datetime="{{ "pages.productsIndex.lastUpdated.datetime" | t }}" style="font-weight:500;color:#263035;">{{ "pages.productsIndex.lastUpdated.date" | t }}</time></p>

