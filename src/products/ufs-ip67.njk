    <script>
      function openLightbox(card) {
        var img = card.querySelector('img');
        var name = card.querySelector('.xray-card-name').textContent;
        var params = card.querySelector('.xray-card-params').textContent;
        document.getElementById('lightboxImg').src = img.src;
        document.getElementById('lightboxImg').alt = img.alt;
        document.getElementById('lightboxName').textContent = name;
        var pillsEl = document.getElementById('lightboxPills');
        pillsEl.innerHTML = '';
        params.split('·').forEach(function(p) {
          var pill = document.createElement('span');
          pill.className = 'xray-lightbox-pill';
          pill.textContent = p.trim();
          pillsEl.appendChild(pill);
        });
        document.getElementById('xrayLightbox').classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeLightbox() {
        document.getElementById('xrayLightbox').classList.remove('active');
        document.body.style.overflow = '';
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
      });
    </script>

