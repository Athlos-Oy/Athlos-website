---
navScrolled: true
layout: layouts/base.njk
pagination:
  data: locales.active
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{% if lang == 'en' %}/products/ufs.html{% else %}/{{ lang }}/products/ufs.html{% endif %}"
pageKey: productsUfs
og:
  type: product
  image: https://athlos.fi/images/new_ultra-fast.webp
  imageWidth: 1792
  imageHeight: 2400
twitter:
  image: https://athlos.fi/images/new_ultra-fast.webp
stylesheets:
  - css/style.css
  - css/products.css
preloadImage: /images/new_ultra-fast.webp
nav:
  prefix: "../"
navComment: NAV
omitMain: true
scriptJs: js/products.js
jsonldHeadPartials:
  - partials/product-jsonld/ufs-1.njk
jsonldHeadAfterAnalyticsPartials:
  - partials/product-jsonld/ufs-2.njk
activeProduct: ufs
---
  <!-- PRODUCT SUBNAV -->
{% include "partials/product-subnav.njk" %}

  <main>

    <!-- HERO — split layout: dark left text / right image -->
    <section class="product-hero" style="min-height:80vh; align-items:stretch; display:grid; grid-template-columns:1fr 1fr;">

      <!-- Left: text content -->
      <div style="position:relative; z-index:2; background:var(--charcoal); display:flex; flex-direction:column; justify-content:flex-end; padding: calc(var(--nav-h) + 48px + 4rem) var(--page-x) 4rem; padding-right:3rem;">
        <span class="product-category">{{ "pages.productsUfs.hero.category" | t }}</span>
        <h1 style="font-size:clamp(2.5rem,5vw,4.5rem); font-weight:300; letter-spacing:-0.04em; color:var(--white); margin-bottom:1.5rem; line-height:1;">{{ "pages.productsUfs.hero.headline" | t }}</h1>
        <p class="product-hero-tagline" style="max-width:480px;">
          {{ "pages.productsUfs.hero.tagline" | t }}
        </p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <a href="#overview" class="btn btn-primary">{{ "pages.productsUfs.hero.ctaExplore" | t }}</a>
          <a href="#contact" class="btn btn-outline">{{ "pages.productsUfs.hero.ctaDiscuss" | t }}</a>
        </div>
      </div>

      <!-- Right: product image -->
      <div style="position:relative; overflow:hidden; background:#1A2128; min-height:500px;">
        <img src="/images/new_ultra-fast.webp" width="1792" height="2400" alt="{{ "pages.productsUfs.hero.imageAlt" | t }}"
          style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; opacity:0; transition:opacity 400ms ease;"
          loading="eager"
          onload="this.style.opacity='1'">
      </div>

      <!-- Small screen fallback: full-bleed bg -->
      <style>
        @media (max-width:768px) {
          .ufs-hero-split { grid-template-columns: 1fr !important; }
          .ufs-hero-split > div:last-child { display: none; }
          .ufs-hero-split > div:first-child { padding-right: var(--page-x); }
        }
      </style>
    </section>

    <!-- OVERVIEW -->
    <section class="product-overview" id="overview">
      <div class="container">
        <div class="overview-grid">
          <div class="overview-text">
            <p class="section-eyebrow reveal">{{ "pages.productsUfs.overview.eyebrow" | t }}</p>
            <h2 class="overview-headline reveal">{{ "pages.productsUfs.overview.headline" | t }}</h2>
            <p class="overview-body reveal">
              {{ "pages.productsUfs.overview.body1" | t }}
            </p>
            <p class="overview-body reveal">
              {{ "pages.productsUfs.overview.body2" | t }}
            </p>
            <p class="overview-body reveal">
              {{ "pages.productsUfs.overview.body3" | t }}
            </p>

            <div class="sdk-callout reveal">
              <div class="sdk-callout-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M6 5V4a3 3 0 016 0v1" stroke="currentColor" stroke-width="1.5"/><path d="M6 10l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <p class="sdk-callout-title">{{ "pages.productsUfs.overview.sdkCallout.title" | t }}</p>
                <p class="sdk-callout-body">{{ "pages.productsUfs.overview.sdkCallout.body" | t }}</p>
              </div>
            </div>
          </div>
          <div class="overview-visual aspect-portrait reveal">
            <img src="/images/ufs-white-bg.webp" width="1792" height="2400" alt="{{ "pages.productsUfs.overview.imageAlt" | t }}" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="highlights-section">
      <div class="container">
        <div class="highlights-header">
          <p class="section-eyebrow reveal">{{ "pages.productsUfs.highlights.eyebrow" | t }}</p>
          <h2 class="section-headline reveal" style="font-size:var(--text-2xl)">{{ "pages.productsUfs.highlights.headline" | t }}</h2>
        </div>
        <div class="highlights-grid">
          <div class="highlight-card reveal">
            <span class="highlight-number">01</span>
            <h3 class="highlight-title">{{ "pages.productsUfs.highlights.cards.directConversion.title" | t }}</h3>
            <p class="highlight-body">{{ "pages.productsUfs.highlights.cards.directConversion.body" | t }}</p>
          </div>
          <div class="highlight-card reveal" data-delay="60">
            <span class="highlight-number">02</span>
            <h3 class="highlight-title">{{ "pages.productsUfs.highlights.cards.ultraFast.title" | t }}</h3>
            <p class="highlight-body">{{ "pages.productsUfs.highlights.cards.ultraFast.body" | t }}</p>
          </div>
          <div class="highlight-card reveal" data-delay="120">
            <span class="highlight-number">03</span>
            <h3 class="highlight-title">{{ "pages.productsUfs.highlights.cards.dynamicRange.title" | t }}</h3>
            <p class="highlight-body">{{ "pages.productsUfs.highlights.cards.dynamicRange.body" | t }}</p>
          </div>
          <div class="highlight-card reveal" data-delay="60">
            <span class="highlight-number">04</span>
            <h3 class="highlight-title">{{ "pages.productsUfs.highlights.cards.singlePhoton.title" | t }}</h3>
            <p class="highlight-body">{{ "pages.productsUfs.highlights.cards.singlePhoton.body" | t }}</p>
          </div>
          <div class="highlight-card reveal" data-delay="120">
            <span class="highlight-number">05</span>
            <h3 class="highlight-title">{{ "pages.productsUfs.highlights.cards.gigE.title" | t }}</h3>
            <p class="highlight-body">{{ "pages.productsUfs.highlights.cards.gigE.body" | t }}</p>
          </div>
          <div class="highlight-card reveal" data-delay="180">
            <span class="highlight-number">06</span>
            <h3 class="highlight-title">{{ "pages.productsUfs.highlights.cards.sdk.title" | t }}</h3>
            <p class="highlight-body">{{ "pages.productsUfs.highlights.cards.sdk.body" | t }}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MODELS -->
    <section class="models-section">
      <div class="container">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:clamp(3rem,6vw,6rem); align-items:center;">
          <div>
            <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.productsUfs.models.eyebrow" | t }}</p>
            <h2 class="section-headline section-headline--light reveal">{{ "pages.productsUfs.models.headline" | t }}</h2>
            <p class="reveal" style="font-size:var(--text-md);font-weight:300;line-height:1.75;color:rgba(255,255,255,0.6);">
              {{ "pages.productsUfs.models.body1" | t }}
            </p>
            <p class="reveal" style="font-size:var(--text-md);font-weight:300;line-height:1.75;color:rgba(255,255,255,0.6); margin-top:1rem;">
              {{ "pages.productsUfs.models.body2" | t }}
            </p>
          </div>
          <div class="reveal">
            <img src="/images/ufs-family-new.png" width="1792" height="2400" alt="{{ "pages.productsUfs.models.imageAlt" | t }}" loading="lazy"
              style="border-radius:var(--r-xl); width:100%; object-fit:cover; max-height:360px;">
          </div>
        </div>
        <div class="models-grid" style="margin-top:3rem;">
          <div class="model-card reveal">
            <span class="model-name">{{ "pages.productsUfs.models.cards.ufs150.name" | t }}</span>
            <span class="model-ref">{{ "pages.productsUfs.models.cards.ufs150.ref" | t }}</span>
            <p style="font-size:var(--text-sm);font-weight:300;line-height:1.65;color:rgba(255,255,255,0.55);">
              {{ "pages.productsUfs.models.cards.ufs150.body" | t }}
            </p>
            <div class="model-widths">
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs150.width1" | t }}</span>
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs150.width2" | t }}</span>
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs150.width3" | t }}</span>
            </div>
          </div>
          <div class="model-card reveal" data-delay="80">
            <span class="model-name">{{ "pages.productsUfs.models.cards.ufs225.name" | t }}</span>
            <span class="model-ref">{{ "pages.productsUfs.models.cards.ufs225.ref" | t }}</span>
            <p style="font-size:var(--text-sm);font-weight:300;line-height:1.65;color:rgba(255,255,255,0.55);">
              {{ "pages.productsUfs.models.cards.ufs225.body" | t }}
            </p>
            <div class="model-widths">
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs225.width1" | t }}</span>
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs225.width2" | t }}</span>
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs225.width3" | t }}</span>
            </div>
          </div>
          <div class="model-card reveal" data-delay="160">
            <span class="model-name">{{ "pages.productsUfs.models.cards.ufs460.name" | t }}</span>
            <span class="model-ref">{{ "pages.productsUfs.models.cards.ufs460.ref" | t }}</span>
            <p style="font-size:var(--text-sm);font-weight:300;line-height:1.65;color:rgba(255,255,255,0.55);">
              {{ "pages.productsUfs.models.cards.ufs460.body" | t }}
            </p>
            <div class="model-widths">
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs460.width1" | t }}</span>
              <span class="model-width-tag">{{ "pages.productsUfs.models.cards.ufs460.width2" | t }}</span>
            </div>
          </div>
          <div class="model-card reveal" data-delay="240">
            <span class="model-name">{{ "pages.productsUfs.models.cards.ufsxxx.name" | t }}</span>
            <span class="model-ref">{{ "pages.productsUfs.models.cards.ufsxxx.ref" | t }}</span>
            <p style="font-size:var(--text-sm);font-weight:300;line-height:1.65;color:rgba(255,255,255,0.55);">
              {{ "pages.productsUfs.models.cards.ufsxxx.body" | t }}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PERFORMANCE -->
    <section class="performance-section">
      <div class="container">
        <div style="text-align:center; max-width:580px; margin:0 auto;">
          <p class="section-eyebrow reveal">{{ "pages.productsUfs.performance.eyebrow" | t }}</p>
          <h2 class="section-headline reveal" style="font-size:var(--text-2xl)">{{ "pages.productsUfs.performance.headline" | t }}</h2>
        </div>
        <div class="performance-grid">
          <div class="perf-card reveal">
            <span class="perf-resolution">{{ "pages.productsUfs.performance.cards.res100.resolution" | t }}</span>
            <span class="perf-speed">{{ "pages.productsUfs.performance.cards.res100.speed" | t }}</span>
            <span class="perf-unit">{{ "pages.productsUfs.performance.cards.res100.unit" | t }}</span>
          </div>
          <div class="perf-card reveal" data-delay="80">
            <span class="perf-resolution">{{ "pages.productsUfs.performance.cards.res200.resolution" | t }}</span>
            <span class="perf-speed">{{ "pages.productsUfs.performance.cards.res200.speed" | t }}</span>
            <span class="perf-unit">{{ "pages.productsUfs.performance.cards.res200.unit" | t }}</span>
          </div>
          <div class="perf-card reveal" data-delay="160">
            <span class="perf-resolution">{{ "pages.productsUfs.performance.cards.res400.resolution" | t }}</span>
            <span class="perf-speed">{{ "pages.productsUfs.performance.cards.res400.speed" | t }}</span>
            <span class="perf-unit">{{ "pages.productsUfs.performance.cards.res400.unit" | t }}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- UFS X-RAY GALLERY -->
    <section class="xray-gallery-section">
      <div class="container">
        <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.productsUfs.gallery.eyebrow" | t }}</p>
        <h2 class="section-headline section-headline--light reveal" style="font-size:var(--text-2xl); margin-bottom:2rem;">{{ "pages.productsUfs.gallery.headline" | t }}</h2>

        <!-- Tabs -->
        <div class="gallery-tabs" style="margin-bottom:2rem;">
          <button class="gallery-tab active" data-tab="panoramic">{{ "pages.productsUfs.gallery.tabs.panoramic" | t }}</button>
          <button class="gallery-tab" data-tab="cephalo">{{ "pages.productsUfs.gallery.tabs.cephalo" | t }}</button>
        </div>

        <!-- Panoramic panel -->
        <div class="gallery-panel active" data-panel="panoramic">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
            <div class="simple-gallery-item" style="cursor:pointer;">
              <img src="/images/ufs-scan-1.webp" width="945" height="510" alt="{{ "pages.productsUfs.gallery.images.panoramic1Alt" | t }}" loading="lazy" style="width:100%; border-radius:var(--r-lg);">
            </div>
            <div class="simple-gallery-item" style="cursor:pointer;">
              <img src="/images/ufs-scan-2.webp" width="927" height="519" alt="{{ "pages.productsUfs.gallery.images.panoramic2Alt" | t }}" loading="lazy" style="width:100%; border-radius:var(--r-lg);">
            </div>
          </div>
        </div>

        <!-- Cephalo panel -->
        <div class="gallery-panel" data-panel="cephalo">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
            <div class="simple-gallery-item" style="cursor:pointer;">
              <img src="/images/Picture3.webp" width="612" height="516" alt="{{ "pages.productsUfs.gallery.images.cephalo1Alt" | t }}" loading="lazy" style="width:100%; border-radius:var(--r-lg);">
            </div>
            <div class="simple-gallery-item" style="cursor:pointer;">
              <img src="/images/ufs-cephalo-2.png" width="2722" height="2253" alt="{{ "pages.productsUfs.gallery.images.cephalo2Alt" | t }}" loading="lazy" style="width:100%; border-radius:var(--r-lg);">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div class="gallery-lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="{{ "pages.productsUfs.gallery.lightbox.ariaLabel" | t }}">
      <button class="gallery-lightbox-close" aria-label="{{ "pages.productsUfs.gallery.lightbox.closeAria" | t }}">✕</button>
      <img class="gallery-lightbox-img" src="" alt="{{ "pages.productsUfs.gallery.lightbox.imgAlt" | t }}" loading="lazy">
    </div>

    <!-- CTA -->
    <section class="product-cta" id="contact">
      <div class="container">
        <div class="product-cta-inner">
          <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.productsUfs.cta.eyebrow" | t }}</p>
          <h2 class="reveal">{{ "pages.productsUfs.cta.headline" | t }}</h2>
          <p class="reveal">{{ "pages.productsUfs.cta.body" | t }}</p>
          <div class="reveal" style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="../contact.html" class="btn btn-primary btn-large">{{ "pages.productsUfs.cta.buttonContact" | t }}</a>
            <a href="index.html" class="btn btn-outline" style="border-color:rgba(255,255,255,0.3);">{{ "pages.productsUfs.cta.buttonAll" | t }}</a>
          </div>
        </div>
      </div>
    </section>

    <p style="max-width:1280px;margin:0 auto;padding:0 clamp(1.5rem,5vw,5rem) clamp(2rem,4vw,3rem);font-size:0.75rem;font-weight:400;letter-spacing:0.04em;color:#8C959B;text-align:center;">{{ "pages.productsUfs.lastUpdated.label" | t }} <time datetime="{{ "pages.productsUfs.lastUpdated.datetime" | t }}" style="font-weight:500;color:#263035;">{{ "pages.productsUfs.lastUpdated.date" | t }}</time></p>

  </main>

  <!-- FOOTER -->
