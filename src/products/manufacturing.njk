---
navScrolled: true
layout: layouts/base.njk
pagination:
  data: locales.active
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{% if lang == 'en' %}/products/manufacturing.html{% else %}/{{ lang }}/products/manufacturing.html{% endif %}"
pageKey: productsManufacturing
og:
  type: website
  image: https://athlos.fi/images/manufacturing-wafer-1.webp
  imageWidth: 2400
  imageHeight: 1792
twitter:
  image: https://athlos.fi/images/manufacturing-wafer-1.webp
stylesheets:
  - css/style.css
  - css/products.css
preloadImage: /images/manufacturing-wafer-1.webp
nav:
  prefix: "../"
navComment: NAV
omitMain: true
scriptJs: js/products.js
activeProduct: manufacturing
jsonldHeadPartials:
  - partials/product-jsonld/manufacturing-1.njk
jsonldHeadAfterAnalyticsPartials:
  - partials/product-jsonld/manufacturing-2.njk
---
  <!-- PRODUCT SUBNAV -->
{% include "partials/product-subnav.njk" %}

  <main>

    <!-- HERO -->
    <section class="product-hero" style="min-height:70vh;">
      <div class="product-hero-bg" style="background-image: url('../images/manufacturing-wafer-1.webp'); background-position:center;"></div>
      <div class="product-hero-overlay" style="background:linear-gradient(120deg, rgba(10,18,24,0.70) 40%, rgba(20,35,48,0.35) 100%);"></div>
      <div class="product-hero-gradient"></div>
      <div class="product-hero-content container">
        <span class="product-category">{{ "pages.productsManufacturing.hero.category" | t }}</span>
        <h1>{{ "pages.productsManufacturing.hero.headline" | t }}</h1>
        <p class="product-hero-tagline">{{ "pages.productsManufacturing.hero.tagline" | t }}</p>
      </div>
    </section>

    <!-- OVERVIEW -->
    <section style="padding: var(--section-py) 0; background: var(--charcoal);">
      <div class="container">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center;">
          <div>
            <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.productsManufacturing.overview.eyebrow" | t }}</p>
            <h2 class="section-headline section-headline--light reveal">{{ "pages.productsManufacturing.overview.headline" | t }}</h2>
            <p class="reveal" style="font-size:var(--text-md); font-weight:300; line-height:1.8; color:rgba(255,255,255,0.7); margin-bottom:1rem;">
              {{ "pages.productsManufacturing.overview.body1" | t }}
            </p>
            <p class="reveal" style="font-size:var(--text-md); font-weight:300; line-height:1.8; color:rgba(255,255,255,0.7);">
              {{ "pages.productsManufacturing.overview.body2" | t }}
            </p>
          </div>
          <div class="reveal">
            <img src="../images/manufacturing-wafer-1.webp" width="2400" height="1792" alt="{{ "pages.productsManufacturing.overview.imageAlt" | t }}" loading="lazy" style="width:100%; border-radius:var(--r-lg); aspect-ratio:4/3; object-fit:cover;">
          </div>
        </div>
      </div>
    </section>

    <!-- (Image gallery removed — images moved into Overview and Capabilities sections) -->

    <!-- CAPABILITIES -->
    <section style="padding: var(--section-py) 0; background: var(--white);">
      <div class="container">
        <p class="section-eyebrow reveal">{{ "pages.productsManufacturing.capabilities.eyebrow" | t }}</p>
        <h2 class="section-headline reveal">{{ "pages.productsManufacturing.capabilities.headline" | t }}</h2>
        <div class="capability-grid">

          <!-- Detector Bumping -->
          <div class="capability-card reveal" data-delay="0">
            <div class="capability-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="4" cy="4" r="1.5" fill="currentColor"/>
                <circle cx="10" cy="4" r="1.5" fill="currentColor"/>
                <circle cx="16" cy="4" r="1.5" fill="currentColor"/>
                <circle cx="4" cy="10" r="1.5" fill="currentColor"/>
                <circle cx="10" cy="10" r="1.5" fill="currentColor"/>
                <circle cx="16" cy="10" r="1.5" fill="currentColor"/>
                <circle cx="4" cy="16" r="1.5" fill="currentColor"/>
                <circle cx="10" cy="16" r="1.5" fill="currentColor"/>
                <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="capability-title">{{ "pages.productsManufacturing.capabilities.cards.bumping.title" | t }}</h3>
            <p class="capability-body">{{ "pages.productsManufacturing.capabilities.cards.bumping.body" | t }}</p>
          </div>

          <!-- Flip Chip Bonding -->
          <div class="capability-card reveal" data-delay="80">
            <div class="capability-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="1" y="2" width="18" height="6" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <rect x="1" y="12" width="18" height="6" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <line x1="6" y1="8" x2="6" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="10" y1="8" x2="10" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="14" y1="8" x2="14" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="capability-title">{{ "pages.productsManufacturing.capabilities.cards.flipChip.title" | t }}</h3>
            <p class="capability-body">{{ "pages.productsManufacturing.capabilities.cards.flipChip.body" | t }}</p>
          </div>

          <!-- Wire Bonding -->
          <div class="capability-card reveal" data-delay="160">
            <div class="capability-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="2.5" cy="15" r="1.5" fill="currentColor"/>
                <circle cx="17.5" cy="15" r="1.5" fill="currentColor"/>
                <path d="M2.5 15 C2.5 4, 17.5 4, 17.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              </svg>
            </div>
            <h3 class="capability-title">{{ "pages.productsManufacturing.capabilities.cards.wire.title" | t }}</h3>
            <p class="capability-body">{{ "pages.productsManufacturing.capabilities.cards.wire.body" | t }}</p>
          </div>

          <!-- X-Ray Probing & Characterization -->
          <div class="capability-card reveal" data-delay="0">
            <div class="capability-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <line x1="10" y1="1" x2="10" y2="4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="10" y1="16" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="1" y1="10" x2="4" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="16" y1="10" x2="19" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="capability-title">{{ "pages.productsManufacturing.capabilities.cards.probing.title" | t }}</h3>
            <p class="capability-body">{{ "pages.productsManufacturing.capabilities.cards.probing.body" | t }}</p>
          </div>

          <!-- Die Bonding & Assembly -->
          <div class="capability-card reveal" data-delay="80">
            <div class="capability-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="11" width="14" height="6" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <rect x="5" y="6" width="10" height="5" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <rect x="7" y="2" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <h3 class="capability-title">{{ "pages.productsManufacturing.capabilities.cards.dieBonding.title" | t }}</h3>
            <p class="capability-body">{{ "pages.productsManufacturing.capabilities.cards.dieBonding.body" | t }}</p>
          </div>

          <!-- Quality & Reliability -->
          <div class="capability-card reveal" data-delay="160">
            <div class="capability-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 2L3 5.5V10c0 4 3.1 7.5 7 8.5 3.9-1 7-4.5 7-8.5V5.5L10 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
                <path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="capability-title">{{ "pages.productsManufacturing.capabilities.cards.quality.title" | t }}</h3>
            <p class="capability-body">{{ "pages.productsManufacturing.capabilities.cards.quality.body" | t }}</p>
          </div>

        </div>
      </div>
    </section>

    <!-- FACILITIES / VTT MICRONOVA -->
    <section style="padding: var(--section-py) 0; background: var(--off-white);">
      <div class="container">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center;">
          <div>
            <p class="section-eyebrow reveal">{{ "pages.productsManufacturing.facilities.eyebrow" | t }}</p>
            <h2 class="section-headline reveal" style="font-size:var(--text-2xl);">{{ "pages.productsManufacturing.facilities.headline" | t }}</h2>
            <p class="reveal" style="font-size:var(--text-base); font-weight:300; line-height:1.8; color:var(--gray-steel); margin-bottom:1rem;">
              {{ "pages.productsManufacturing.facilities.body1" | t }}
            </p>
            <p class="reveal" style="font-size:var(--text-base); font-weight:300; line-height:1.8; color:var(--gray-steel);">
              {{ "pages.productsManufacturing.facilities.body2" | t }}
            </p>
          </div>
          <div class="reveal">
            <img src="../images/hero-facility.webp" width="5504" height="3072" alt="{{ "pages.productsManufacturing.facilities.imageAlt" | t }}" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--r-lg);">
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="product-cta" id="contact">
      <div class="container">
        <div class="product-cta-inner">
          <h2 class="reveal">{{ "pages.productsManufacturing.cta.headline" | t }}</h2>
          <p class="reveal">{{ "pages.productsManufacturing.cta.body" | t }}</p>
          <div class="reveal" style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
            <a href="../contact.html" class="btn btn-primary btn-large">{{ "pages.productsManufacturing.cta.ctaContact" | t }}</a>
            <a href="index.html" class="btn btn-outline" style="border-color:rgba(255,255,255,0.3);">{{ "pages.productsManufacturing.cta.ctaAll" | t }}</a>
          </div>
        </div>
      </div>
    </section>

    <p style="max-width:1280px;margin:0 auto;padding:0 clamp(1.5rem,5vw,5rem) clamp(2rem,4vw,3rem);font-size:0.75rem;font-weight:400;letter-spacing:0.04em;color:#8C959B;text-align:center;">{{ "pages.productsManufacturing.lastUpdated.label" | t }} <time datetime="{{ "pages.productsManufacturing.lastUpdated.datetime" | t }}" style="font-weight:500;color:#263035;">{{ "pages.productsManufacturing.lastUpdated.date" | t }}</time></p>

  </main>

  <!-- FOOTER -->
