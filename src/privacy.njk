---
layout: layouts/base.njk
pagination:
  data: locales.active
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{% if lang == 'en' %}/privacy.html{% else %}/{{ lang }}/privacy.html{% endif %}"
pageKey: privacy
og:
  type: website
  image: https://athlos.fi/images/hero-lab-automation.webp
  imageWidth: 5504
  imageHeight: 3072
twitter:
  image: https://athlos.fi/images/hero-lab-automation.webp
fontUrl: https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,300;1,14..32,400&display=swap
stylesheets:
  - css/style.css
  - css/products.css
preloadImage: /images/hero-cleanroom-worker.webp
includeOrganizationJsonld: true
nav:
  prefix: ""
navComment: NAV
omitMain: true
---
  <!-- PAGE HERO -->
  <section class="page-hero" style="min-height:35vh;">
    <div class="page-hero-bg" style="background-image: url('images/hero-cleanroom-worker.webp'); background-position: center 30%;"></div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <span class="product-category">{{ "pages.privacy.hero.category" | t }}</span>
      <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight:700; color:var(--white); line-height:1.1; margin-bottom:1rem;">{{ "pages.privacy.hero.headline" | t }}</h1>
      <p style="font-size:var(--text-md); font-weight:300; color:rgba(255,255,255,0.75); max-width:580px; line-height:1.7;">
        {{ "pages.privacy.hero.sub" | t }}
      </p>
    </div>
  </section>

