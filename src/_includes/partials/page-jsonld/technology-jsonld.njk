{#-
  Structured data for /technology/direct-conversion.html.
  FAQ, glossary and citation content comes from src/_data/technologyPage.js
  — the SAME data the visible page renders, so schema and on-page text
  cannot drift. English-only page (singleLocale), so no `t` lookups here.
-#}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "TechArticle",
        "@id": "https://athlos.fi/technology/direct-conversion.html#article",
        "headline": "Direct Conversion X-ray Imaging Technology",
        "description": "How direct conversion X-ray sensors convert photons directly into electrical signal — no scintillator light-spread stage. CdTe-CMOS and Si-CMOS architectures, direct vs indirect comparison, TDI scanning, publications and patents since 1993.",
        "url": "https://athlos.fi/technology/direct-conversion.html",
        "mainEntityOfPage": "https://athlos.fi/technology/direct-conversion.html",
        "inLanguage": "en",
        "datePublished": "{{ technologyPage.datePublished }}",
        "dateModified": "{{ technologyPage.dateModified }}",
        "author": { "@id": "https://athlos.fi/#organization" },
        "publisher": { "@id": "https://athlos.fi/#organization" },
        "reviewedBy": { "@id": "https://athlos.fi/about.html#konstantinos-spartiotis" },
        "about": [
          { "@type": "Thing", "name": "Direct conversion X-ray imaging" },
          { "@type": "Thing", "name": "CdTe-CMOS X-ray detectors" },
          { "@type": "Thing", "name": "Si-CMOS X-ray detectors" }
        ],
        "citation": [
{%- for c in technologyPage.citations %}
          {
            "@type": "ScholarlyArticle",
            "headline": {{ c.title | dump | safe }},
            "author": {{ c.authors | dump | safe }},
            "datePublished": {{ c.year | dump | safe }},
            "isPartOf": {{ c.venue | dump | safe }}{% if c.url %},
            "url": {{ c.url | dump | safe }}{% endif %}
          }{{ "," if not loop.last }}
{%- endfor %}
        ]
      },
      {
        "@type": "Person",
        "@id": "https://athlos.fi/about.html#konstantinos-spartiotis",
        "name": "Konstantinos Spartiotis",
        "jobTitle": "Founder & CEO, Athlos Oy",
        "url": "https://athlos.fi/about.html"
      },
      {
        "@type": "FAQPage",
        "@id": "https://athlos.fi/technology/direct-conversion.html#faq",
        "mainEntity": [
{%- for f in technologyPage.faq %}
          { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{{ "," if not loop.last }}
{%- endfor %}
        ]
      },
      {
        "@type": "DefinedTermSet",
        "@id": "https://athlos.fi/technology/direct-conversion.html#glossary",
        "name": "Direct conversion X-ray imaging glossary",
        "hasDefinedTerm": [
{%- for g in technologyPage.glossary %}
          { "@type": "DefinedTerm", "@id": "https://athlos.fi/technology/direct-conversion.html#term-{{ g.id }}", "name": {{ g.term | dump | safe }}, "description": {{ g.def | dump | safe }} }{{ "," if not loop.last }}
{%- endfor %}
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://athlos.fi/" },
          { "@type": "ListItem", "position": 2, "name": "Technology", "item": "https://athlos.fi/technology/direct-conversion.html" },
          { "@type": "ListItem", "position": 3, "name": "Direct Conversion X-ray Imaging" }
        ]
      }
    ]
  }
  </script>
