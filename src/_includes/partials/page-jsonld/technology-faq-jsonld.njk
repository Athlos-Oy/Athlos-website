{#-
  Structured data for /technology/faq.html.
  FAQPage + DefinedTermSet + BreadcrumbList. FAQ and glossary content
  come from src/_data/technologyPage.js — the SAME data the visible page
  renders, so schema and on-page text cannot drift. English-only page
  (singleLocale), so no `t` lookups here.
-#}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FAQPage",
        "@id": "https://athlos.fi/technology/faq.html#faq",
        "url": "https://athlos.fi/technology/faq.html",
        "inLanguage": "en",
        "dateModified": "{{ technologyPage.dateModified }}",
        "mainEntity": [
{%- for f in technologyPage.faq %}
          { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{{ "," if not loop.last }}
{%- endfor %}
        ]
      },
      {
        "@type": "DefinedTermSet",
        "@id": "https://athlos.fi/technology/faq.html#glossary",
        "name": "Direct conversion X-ray imaging glossary",
        "hasDefinedTerm": [
{%- for g in technologyPage.glossary %}
          { "@type": "DefinedTerm", "@id": "https://athlos.fi/technology/faq.html#term-{{ g.id }}", "name": {{ g.term | dump | safe }}, "description": {{ g.def | dump | safe }} }{{ "," if not loop.last }}
{%- endfor %}
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://athlos.fi/" },
          { "@type": "ListItem", "position": 2, "name": "Technology", "item": "https://athlos.fi/technology/direct-conversion.html" },
          { "@type": "ListItem", "position": 3, "name": "Technology FAQ", "item": "https://athlos.fi/technology/faq.html" }
        ]
      }
    ]
  }
  </script>
