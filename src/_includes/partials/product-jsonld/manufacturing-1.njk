        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ "jsonld.productsManufacturing.graph.breadcrumb.products" | t }}",
          "item": "https://athlos.fi/products/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ "jsonld.productsManufacturing.graph.breadcrumb.manufacturing" | t }}",
          "item": "https://athlos.fi/products/manufacturing.html"
        }
      ]
    },
    {
      "@type": "Service",
      "name": "{{ "jsonld.productsManufacturing.graph.service.name" | t }}",
      "description": "{{ "jsonld.productsManufacturing.graph.service.description" | t }}",
      "provider": {
        "@type": "Organization",
        "name": "Athlos Oy",
        "url": "https://athlos.fi"
      },
      "areaServed": "{{ "jsonld.productsManufacturing.graph.service.areaServed" | t }}",
      "serviceType": "{{ "jsonld.productsManufacturing.graph.service.serviceType" | t }}"
    }
  ]
}
  </script>
