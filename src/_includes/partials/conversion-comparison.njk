{#- =====================================================
    DirectConversionComparison — flagship homepage visual
    Pure SVG + CSS (no deps, no JS animation loop). One master
    duration (--dcc-cycle) choreographs every element via keyframe
    %; running is gated on `.dcc-inview` (js/script.js) and replaced
    by a complete static frame under prefers-reduced-motion.
    Copy: i18n pages.home.tech.comparison.*
   ===================================================== -#}
{%- set c = "pages.home.tech.comparison" -%}
{#- isometric slab: shadow + side/top/front faces + bright top edge.
    front edge x 44..258 (centre 151), depth dx34/dy20. -#}
{%- macro slab(y, th, topcls) -%}
        <ellipse class="dcc-shadow" cx="151" cy="{{ y + th + 13 }}" rx="116" ry="12"/>
        <path class="dcc-face-side" d="M258 {{ y }} L292 {{ y - 20 }} L292 {{ y - 20 + th }} L258 {{ y + th }} Z"/>
        <path class="dcc-face-top {{ topcls }}" d="M44 {{ y }} L258 {{ y }} L292 {{ y - 20 }} L78 {{ y - 20 }} Z"/>
        <path class="dcc-face-front" d="M44 {{ y }} L258 {{ y }} L258 {{ y + th }} L44 {{ y + th }} Z"/>
        <polyline class="dcc-edge" points="44,{{ y }} 258,{{ y }} 292,{{ y - 20 }}"/>
{%- endmacro -%}
{#- right-side label with a thin drawn-on leader line -#}
{%- macro rlabel(lx, ly, fx, fy, txt, accent) -%}
          <line class="dcc-leader" x1="{{ fx }}" y1="{{ fy }}" x2="{{ lx - 4 }}" y2="{{ ly - 4 }}"/>
          <text class="dcc-tx{{ ' dcc-tx--accent' if accent }}" x="{{ lx }}" y="{{ ly }}">{{ txt }}</text>
{%- endmacro -%}
<div class="dcc-panel reveal">
  <span class="dcc-tick dcc-tick--tl" aria-hidden="true"></span>
  <span class="dcc-tick dcc-tick--tr" aria-hidden="true"></span>
  <span class="dcc-tick dcc-tick--bl" aria-hidden="true"></span>
  <span class="dcc-tick dcc-tick--br" aria-hidden="true"></span>

  <div class="dcc-header">
    <p class="dcc-eyebrow reveal" data-delay="60">{{ (c ~ ".heading") | t }}</p>
    <p class="dcc-sub reveal" data-delay="120">{{ (c ~ ".subheading") | t }}</p>
  </div>

  {#- shared gradient / filter / pattern definitions (kept out of the grid) -#}
  <svg class="dcc-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="dcc-slab-top" x1="0" y1="0" x2="0.35" y2="1">
        <stop offset="0" stop-color="#5d7280" stop-opacity="0.66"/>
        <stop offset="0.5" stop-color="#33424b" stop-opacity="0.52"/>
        <stop offset="1" stop-color="#1c262c" stop-opacity="0.5"/>
      </linearGradient>
      <linearGradient id="dcc-slab-conv" x1="0" y1="0" x2="0.35" y2="1">
        <stop offset="0" stop-color="#4a6878" stop-opacity="0.72"/>
        <stop offset="1" stop-color="#1b2a33" stop-opacity="0.6"/>
      </linearGradient>
      <linearGradient id="dcc-streak-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#cfeaff" stop-opacity="0"/>
        <stop offset="1" stop-color="#eaf6ff" stop-opacity="0.9"/>
      </linearGradient>
      <radialGradient id="dcc-cloud-grad" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fff3cf" stop-opacity="0.95"/>
        <stop offset="0.4" stop-color="#ffd76b" stop-opacity="0.6"/>
        <stop offset="1" stop-color="#f0ad29" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="dcc-charge-grad" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#eaf7ff" stop-opacity="0.95"/>
        <stop offset="0.5" stop-color="#7fd0ff" stop-opacity="0.7"/>
        <stop offset="1" stop-color="#43a1d8" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="dcc-scan-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9fd8ff" stop-opacity="0"/>
        <stop offset="0.7" stop-color="#cfeeff" stop-opacity="0.5"/>
        <stop offset="1" stop-color="#9fd8ff" stop-opacity="0"/>
      </linearGradient>
      <radialGradient id="dcc-vignette" cx="0.5" cy="0.4" r="0.78">
        <stop offset="0" stop-color="#0b141a" stop-opacity="0"/>
        <stop offset="1" stop-color="#060b10" stop-opacity="0.9"/>
      </radialGradient>
      <pattern id="dcc-grid" width="30" height="30" patternUnits="userSpaceOnUse">
        <path d="M30 0H0V30" fill="none" stroke="#7dbfe8" stroke-opacity="0.06" stroke-width="1"/>
      </pattern>
      {#- volumetric organic light: static turbulence displaces the cloud, then blur -#}
      <filter id="dcc-cloud-vol" x="-90%" y="-90%" width="280%" height="280%">
        <feTurbulence type="fractalNoise" baseFrequency="0.02 0.025" numOctaves="2" seed="7" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="30" xChannelSelector="R" yChannelSelector="G" result="d"/>
        <feGaussianBlur in="d" stdDeviation="4.5"/>
      </filter>
      <filter id="dcc-soft-out" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="2.4"/>
      </filter>
      <filter id="dcc-glow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="2.1"/>
      </filter>
      <filter id="dcc-glow-strong" x="-120%" y="-120%" width="340%" height="340%">
        <feGaussianBlur stdDeviation="4"/>
      </filter>
    </defs>
  </svg>

  <div class="dcc-stage">
    {#- ======================= INDIRECT ======================= -#}
    <div class="dcc-side dcc-side--indirect">
      <p class="dcc-side-title">{{ (c ~ ".indirectTitle") | t }}</p>
      <svg class="dcc-svg" viewBox="0 0 470 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
        <g class="dcc-bg">
          <rect x="0" y="0" width="470" height="560" fill="url(#dcc-grid)"/>
          <rect x="0" y="0" width="470" height="560" fill="url(#dcc-vignette)"/>
        </g>
        <g class="dcc-fg">
          {#- incoming X-ray photons: fine streaks with luminous heads -#}
          <g class="dcc-photons">
            <g class="dcc-a-photon" style="--pd:0s"><line class="dcc-streak" x1="116" y1="116" x2="116" y2="146"/><circle class="dcc-head" cx="116" cy="146" r="2.4"/></g>
            <g class="dcc-a-photon" style="--pd:.5s"><line class="dcc-streak" x1="151" y1="116" x2="151" y2="146"/><circle class="dcc-head" cx="151" cy="146" r="2.4"/></g>
            <g class="dcc-a-photon" style="--pd:1s"><line class="dcc-streak" x1="186" y1="116" x2="186" y2="146"/><circle class="dcc-head" cx="186" cy="146" r="2.4"/></g>
          </g>

          {#- SCINTILLATOR (y148) -> PHOTODIODE (y228) -> READOUT (y308) -#}
          {{ slab(148, 12, "dcc-face-top--scint") }}
          <path class="dcc-a-scint" d="M44 148 L258 148 L292 128 L78 128 Z"/>
          {#- impact flashes + radiating light rays at the scintillator surface -#}
          <g class="dcc-flashes">
            <circle class="dcc-a-flash" style="--pd:0s"  cx="116" cy="148" r="6" fill="url(#dcc-cloud-grad)" filter="url(#dcc-glow-strong)"/>
            <circle class="dcc-a-flash" style="--pd:.5s" cx="151" cy="148" r="6" fill="url(#dcc-cloud-grad)" filter="url(#dcc-glow-strong)"/>
            <circle class="dcc-a-flash" style="--pd:1s"  cx="186" cy="148" r="6" fill="url(#dcc-cloud-grad)" filter="url(#dcc-glow-strong)"/>
          </g>
          <g class="dcc-a-ray">
            <line class="dcc-ray" x1="151" y1="162" x2="118" y2="150"/>
            <line class="dcc-ray" x1="151" y1="162" x2="184" y2="150"/>
            <line class="dcc-ray" x1="151" y1="162" x2="130" y2="180"/>
            <line class="dcc-ray" x1="151" y1="162" x2="172" y2="180"/>
          </g>

          {{ slab(228, 12, "") }}
          {{ slab(308, 12, "") }}
          {#- readout micro-traces that energise with a travelling pulse -#}
          <g class="dcc-traces">
            <polyline class="dcc-a-trace" style="--pd:0s"  points="88,300 140,300 150,294 214,294"/>
            <polyline class="dcc-a-trace" style="--pd:.3s" points="96,305 168,305 178,299 246,299"/>
          </g>

          {#- the light: warm volumetric cloud that spreads at the scintillator
              then drifts soft and wide all the way down to the output -#}
          <g class="dcc-clouds">
            <circle class="dcc-a-cloud" style="--pd:0s"   cx="151" cy="168" r="22" fill="url(#dcc-cloud-grad)" filter="url(#dcc-cloud-vol)"/>
            <circle class="dcc-a-cloud" style="--pd:.6s"  cx="170" cy="168" r="19" fill="url(#dcc-cloud-grad)" filter="url(#dcc-cloud-vol)"/>
            <circle class="dcc-a-cloud" style="--pd:1.2s" cx="136" cy="168" r="18" fill="url(#dcc-cloud-grad)" filter="url(#dcc-cloud-vol)"/>
          </g>

          {#- output image plane (softer) -#}
          <g class="dcc-a-out">
            <rect class="dcc-screen" x="54" y="372" width="194" height="120" rx="10"/>
            <g class="dcc-bars" filter="url(#dcc-soft-out)">
              <rect x="74"  y="392" width="6" height="72"/><rect x="86"  y="392" width="6" height="72"/><rect x="98" y="392" width="6" height="72"/>
              <rect x="120" y="392" width="4" height="72"/><rect x="129" y="392" width="4" height="72"/><rect x="138" y="392" width="4" height="72"/>
              <rect x="156" y="392" width="3" height="72"/><rect x="163" y="392" width="3" height="72"/><rect x="170" y="392" width="3" height="72"/>
              <rect x="188" y="392" width="2" height="72"/><rect x="194" y="392" width="2" height="72"/><rect x="200" y="392" width="2" height="72"/><rect x="206" y="392" width="2" height="72"/>
            </g>
            <g class="dcc-a-scan"><rect x="54" y="372" width="194" height="14" fill="url(#dcc-scan-grad)"/><line class="dcc-scan-edge" x1="54" y1="379" x2="248" y2="379"/></g>
          </g>

          {#- labels with drawn-on leader lines -#}
          <g class="dcc-label">
            {{ rlabel(300, 142, 262, 138, (c ~ ".indirect.scintillator") | t, false) }}
            {{ rlabel(300, 196, 220, 188, (c ~ ".indirect.spread") | t, true) }}
            {{ rlabel(300, 226, 262, 224, (c ~ ".indirect.photodiode") | t, false) }}
            {{ rlabel(300, 306, 262, 304, (c ~ ".indirect.readout") | t, false) }}
            <text class="dcc-tx dcc-tx--out" x="151" y="520" text-anchor="middle">{{ (c ~ ".indirect.output") | t }}</text>
          </g>
        </g>
      </svg>
    </div>

    <div class="dcc-divider" aria-hidden="true"></div>

    {#- ======================= DIRECT ======================= -#}
    <div class="dcc-side dcc-side--direct">
      <p class="dcc-side-title">{{ (c ~ ".directTitle") | t }}</p>
      <svg class="dcc-svg" viewBox="0 0 470 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
        <g class="dcc-bg">
          <rect x="0" y="0" width="470" height="560" fill="url(#dcc-grid)"/>
          <rect x="0" y="0" width="470" height="560" fill="url(#dcc-vignette)"/>
        </g>
        <g class="dcc-fg">
          {#- incoming X-ray photons -#}
          <g class="dcc-photons">
            <g class="dcc-a-photon" style="--pd:0s"><line class="dcc-streak" x1="116" y1="140" x2="116" y2="170"/><circle class="dcc-head" cx="116" cy="170" r="2.4"/></g>
            <g class="dcc-a-photon" style="--pd:.5s"><line class="dcc-streak" x1="151" y1="140" x2="151" y2="170"/><circle class="dcc-head" cx="151" cy="170" r="2.4"/></g>
            <g class="dcc-a-photon" style="--pd:1s"><line class="dcc-streak" x1="186" y1="140" x2="186" y2="170"/><circle class="dcc-head" cx="186" cy="170" r="2.4"/></g>
          </g>

          {#- CdTe / Si conversion layer (y172, thicker) -#}
          {{ slab(172, 18, "dcc-face-top--conv") }}
          {#- tight vertical charge columns (drawn first, behind the slab edge) -#}
          <g class="dcc-columns">
            <line class="dcc-col" x1="116" y1="190" x2="116" y2="378"/>
            <line class="dcc-col" x1="151" y1="190" x2="151" y2="378"/>
            <line class="dcc-col" x1="186" y1="190" x2="186" y2="378"/>
          </g>
          {#- localized charge generation: crisp flash at impact + descending node -#}
          <g class="dcc-sparks">
            <circle class="dcc-a-spark" style="--pd:0s"  cx="116" cy="172" r="5" fill="url(#dcc-charge-grad)" filter="url(#dcc-glow-strong)"/>
            <circle class="dcc-a-spark" style="--pd:.5s" cx="151" cy="172" r="5" fill="url(#dcc-charge-grad)" filter="url(#dcc-glow-strong)"/>
            <circle class="dcc-a-spark" style="--pd:1s"  cx="186" cy="172" r="5" fill="url(#dcc-charge-grad)" filter="url(#dcc-glow-strong)"/>
          </g>
          <g class="dcc-nodes">
            <circle class="dcc-a-charge" style="--pd:0s"  cx="116" cy="190" r="3.4" filter="url(#dcc-glow)"/>
            <circle class="dcc-a-charge" style="--pd:.5s" cx="151" cy="190" r="3.4" filter="url(#dcc-glow)"/>
            <circle class="dcc-a-charge" style="--pd:1s"  cx="186" cy="190" r="3.4" filter="url(#dcc-glow)"/>
          </g>

          {#- CMOS readout (y300) -#}
          {{ slab(300, 12, "") }}
          <g class="dcc-traces">
            <polyline class="dcc-a-trace" style="--pd:0s"  points="88,292 140,292 150,286 214,286"/>
            <polyline class="dcc-a-trace" style="--pd:.3s" points="96,297 168,297 178,291 246,291"/>
          </g>

          {#- output image plane (sharper) -#}
          <g class="dcc-a-out">
            <rect class="dcc-screen" x="54" y="372" width="194" height="120" rx="10"/>
            <g class="dcc-bars dcc-bars--sharp">
              <rect x="74"  y="392" width="6" height="72"/><rect x="86"  y="392" width="6" height="72"/><rect x="98" y="392" width="6" height="72"/>
              <rect x="120" y="392" width="4" height="72"/><rect x="129" y="392" width="4" height="72"/><rect x="138" y="392" width="4" height="72"/>
              <rect x="156" y="392" width="3" height="72"/><rect x="163" y="392" width="3" height="72"/><rect x="170" y="392" width="3" height="72"/>
              <rect x="188" y="392" width="2" height="72"/><rect x="194" y="392" width="2" height="72"/><rect x="200" y="392" width="2" height="72"/><rect x="206" y="392" width="2" height="72"/>
            </g>
            <g class="dcc-a-scan"><rect x="54" y="372" width="194" height="14" fill="url(#dcc-scan-grad)"/><line class="dcc-scan-edge" x1="54" y1="379" x2="248" y2="379"/></g>
          </g>

          {#- labels -#}
          <g class="dcc-label">
            <line class="dcc-leader" x1="262" y1="168" x2="296" y2="166"/>
            <text class="dcc-tx" x="300" y="164"><tspan x="300" dy="0">{{ (c ~ ".direct.conversion") | t }}</tspan></text>
            {{ rlabel(300, 214, 200, 210, (c ~ ".direct.charge") | t, true) }}
            {{ rlabel(300, 298, 262, 296, (c ~ ".direct.cmos") | t, false) }}
            <text class="dcc-tx dcc-tx--out" x="151" y="520" text-anchor="middle">{{ (c ~ ".direct.output") | t }}</text>
          </g>
        </g>
      </svg>
    </div>
  </div>

  <p class="dcc-footnote reveal" data-delay="160">{{ (c ~ ".bottomLine") | t }}</p>
  <p class="dcc-microcopy reveal" data-delay="200">{{ (c ~ ".microcopy") | t }}</p>
  <p class="dcc-sr-only">{{ (c ~ ".ariaDescription") | t }}</p>
</div>
