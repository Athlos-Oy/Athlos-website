  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ og.title or title }}">
  <meta property="og:description" content="{{ og.description or description }}">
  <meta property="og:type" content="{{ og.type or 'website' }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ og.image }}">
{%- if og.imageWidth %}
  <meta property="og:image:width" content="{{ og.imageWidth }}">
  <meta property="og:image:height" content="{{ og.imageHeight }}">
{%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ twitter.title or og.title or title }}">
  <meta name="twitter:description" content="{{ twitter.description or og.description or description }}">
  <meta name="twitter:image" content="{{ twitter.image or og.image }}">
  <link rel="canonical" href="{{ canonical }}">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">
