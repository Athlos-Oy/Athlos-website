{#
  Footer. All ASSET URLs absolute (/images/...). All INTERNAL LINKS
  absolute EN-canonical paths run through localeUrl filter using
  the current `lang`. Site constants (site.legalName, address, etc.)
  are interpolated from src/_data/site.json.
#}
  <footer class="footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <div class="footer-logo-wrap">
            <img src="/images/athlos-logo.webp" width="512" height="341" alt="Athlos" class="footer-logo" loading="lazy">
          </div>
          <p class="footer-tagline">{{ site.legalName }}<br>{{ site.address.street }}<br>{{ site.address.postalDisplay }} {{ site.address.city }}<br>{{ "footer.country" | t }}<br><br>{{ "footer.businessIdLabel" | t }} {{ site.businessId }} &nbsp;&middot;&nbsp; {{ "footer.vatLabel" | t }} {{ site.vat }}</p>
        </div>
        <nav class="footer-nav"{% if footerNavAriaLabel %} aria-label="{{ "footer.aria.nav" | t }}"{% endif %}>
          <div class="footer-col">
            <span class="footer-col-label">{{ "footer.columns.products" | t }}</span>
            <a href="{{ "/products/wios.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.dcAir" | t | safe }}</a>
            <a href="{{ "/products/ufs.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.ufs" | t }}</a>
            <a href="{{ "/products/ufs-ip67.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.ufsIp67" | t }}</a>
            <a href="{{ "/products/manufacturing.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.manufacturing" | t }}</a>
            <a href="{{ "/products/software.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.software" | t }}</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-label">{{ "footer.columns.applications" | t }}</span>
            <a href="{{ "/applications.html" | localeUrl(lang) }}#dental" class="footer-link">{{ "footer.links.dental" | t }}</a>
            <a href="{{ "/applications.html" | localeUrl(lang) }}#industrial" class="footer-link">{{ "footer.links.industrial" | t }}</a>
            <a href="{{ "/applications.html" | localeUrl(lang) }}#medical" class="footer-link">{{ "footer.links.medical" | t }}</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-label">{{ "footer.columns.company" | t }}</span>
            <a href="{{ "/about.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.about" | t }}</a>
            {#- English-only pages — direct EN URLs on every locale. -#}
            <a href="/technology/direct-conversion.html" class="footer-link">{{ "footer.links.technology" | t }}</a>
            <a href="/technology/faq.html" class="footer-link">{{ "footer.links.technologyFaq" | t }}</a>
            <a href="{{ "/products/manufacturing.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.manufacturingShort" | t }}</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-label">{{ "footer.columns.contact" | t }}</span>
            <a href="mailto:{{ site.email }}" class="footer-link">{{ site.email }}</a>
            <a href="{{ site.linkedinFull }}" class="footer-link" target="_blank" rel="noopener">{{ "footer.links.linkedin" | t }}</a>
            <a href="{{ "/privacy.html" | localeUrl(lang) }}" class="footer-link">{{ "footer.links.privacy" | t }}</a>
          </div>
        </nav>
      </div>
      <div class="footer-bottom">
        <p class="footer-copy">© 2026 {{ site.legalName }}. {{ "footer.copyAllRights" | t }} {{ "footer.copyMadeIn" | t }}</p>
        <p class="footer-cert">{{ "footer.cert" | t }}</p>
        <p class="footer-legal">{{ site.address.street }} &nbsp;&middot;&nbsp; {{ site.address.postalDisplay }} {{ site.address.city }}, {{ "footer.country" | t }} &nbsp;&middot;&nbsp; {{ "footer.businessIdLabel" | t }} {{ site.businessId }} &nbsp;&middot;&nbsp; {{ "footer.vatLabel" | t }} {{ site.vat }}</p>
      </div>
    </div>
  </footer>
