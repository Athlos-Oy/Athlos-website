{#
  Top navigation + mobile menu.

  All ASSET URLs (logo image, etc.) are absolute (/images/...). This
  way they resolve identically regardless of where the rendered page
  lives in the URL tree (root, /products/, /de/, /de/products/).

  All INTERNAL LINK URLs are absolute EN-canonical paths run through
  the localeUrl filter using the current `lang` (set by pagination
  alias). For EN pages this is a no-op; for DE pages it prepends /de/.

  Per-page flags:
    navScrolled — adds "scrolled" class to <header>. Product detail
                  pages only.

  Strings come from i18n/<locale>.json via the t filter (throws on
  missing keys).
#}
  <header class="nav{% if navScrolled %} scrolled{% endif %}" id="nav">
    <div class="nav-inner">
      <a href="{{ "/index.html" | localeUrl(lang) }}" class="nav-logo" aria-label="{{ "nav.aria.homeLogo" | t }}">
        <img src="/images/athlos-logo.webp" width="512" height="341" alt="Athlos" class="nav-logo-png">
        <span class="nav-logo-text"{% if lang == "en" and not nav.prefix %} aria-hidden="true"{% endif %}>ATHLOS</span>
      </a>
      <nav class="nav-links"{% if lang == "en" and not nav.prefix %} aria-label="{{ "nav.aria.main" | t }}"{% endif %}>
        <a href="{{ "/index.html" | localeUrl(lang) }}" class="nav-link">{{ "nav.home" | t }}</a>
        <div class="nav-item has-dropdown">
          <a href="{{ "/products/index.html" | localeUrl(lang) }}" class="nav-link">{{ "nav.products" | t }} <svg class="nav-link-chevron" viewBox="0 0 10 10" fill="none" width="10" height="10"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="nav-dropdown">
            <a href="{{ "/products/wios.html" | localeUrl(lang) }}" class="nav-dropdown-link">{{ "nav.productDropdown.dcAir" | t | safe }}</a>
            <a href="{{ "/products/ufs.html" | localeUrl(lang) }}" class="nav-dropdown-link">{{ "nav.productDropdown.ufs" | t }}</a>
            <a href="{{ "/products/ufs-ip67.html" | localeUrl(lang) }}" class="nav-dropdown-link">{{ "nav.productDropdown.ufsIp67" | t }}</a>
            <a href="{{ "/products/manufacturing.html" | localeUrl(lang) }}" class="nav-dropdown-link">{{ "nav.productDropdown.manufacturing" | t }}</a>
            <a href="{{ "/products/software.html" | localeUrl(lang) }}" class="nav-dropdown-link">{{ "nav.productDropdown.software" | t }}</a>
          </div>
        </div>
        {#- Technology page is English-only (singleLocale) — link the EN
            URL directly on every locale, no localeUrl prefixing. -#}
        <a href="/technology/direct-conversion.html" class="nav-link">{{ "nav.technology" | t }}</a>
        <a href="{{ "/applications.html" | localeUrl(lang) }}" class="nav-link">{{ "nav.applications" | t }}</a>
        <a href="{{ "/about.html" | localeUrl(lang) }}" class="nav-link">{{ "nav.about" | t }}</a>
      </nav>
      <a href="{{ "/contact.html" | localeUrl(lang) }}" class="nav-cta">{{ "nav.contact" | t }}</a>
{% include "partials/lang-switcher.njk" %}
      <button class="nav-hamburger" aria-label="{{ "nav.aria.openMenu" | t }}" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="nav-mobile-menu" id="mobileMenu">
      <a href="{{ "/index.html" | localeUrl(lang) }}" class="nav-mobile-link">{{ "nav.home" | t }}</a>
      <button type="button" class="nav-mobile-link nav-mobile-toggle" aria-expanded="false" aria-controls="mobileProductsSubmenu">
        <span>{{ "nav.products" | t }}</span>
        <svg class="nav-mobile-toggle-chevron" viewBox="0 0 10 10" fill="none" width="11" height="11" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="nav-mobile-submenu" id="mobileProductsSubmenu">
        <a href="{{ "/products/index.html" | localeUrl(lang) }}" class="nav-mobile-sublink nav-mobile-sublink-all">{{ "nav.productDropdown.allProducts" | t }}</a>
        <a href="{{ "/products/wios.html" | localeUrl(lang) }}" class="nav-mobile-sublink">{{ "nav.productDropdown.dcAir" | t | safe }}</a>
        <a href="{{ "/products/ufs.html" | localeUrl(lang) }}" class="nav-mobile-sublink">{{ "nav.productDropdown.ufs" | t }}</a>
        <a href="{{ "/products/ufs-ip67.html" | localeUrl(lang) }}" class="nav-mobile-sublink">{{ "nav.productDropdown.ufsIp67" | t }}</a>
        <a href="{{ "/products/manufacturing.html" | localeUrl(lang) }}" class="nav-mobile-sublink">{{ "nav.productDropdown.manufacturing" | t }}</a>
        <a href="{{ "/products/software.html" | localeUrl(lang) }}" class="nav-mobile-sublink">{{ "nav.productDropdown.software" | t }}</a>
      </div>
      <a href="/technology/direct-conversion.html" class="nav-mobile-link">{{ "nav.technology" | t }}</a>
      <a href="{{ "/applications.html" | localeUrl(lang) }}" class="nav-mobile-link">{{ "nav.applications" | t }}</a>
      <a href="{{ "/about.html" | localeUrl(lang) }}" class="nav-mobile-link">{{ "nav.about" | t }}</a>
      <a href="{{ "/contact.html" | localeUrl(lang) }}" class="nav-mobile-link nav-mobile-cta">{{ "nav.contact" | t }}</a>
{% include "partials/lang-switcher.njk" %}
    </div>
  </header>
