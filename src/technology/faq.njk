{#-
  Technology FAQ — ENGLISH ONLY (singleLocale). Holds the longer Q&A and
  the glossary that were moved off the (now short, visual) Technology
  page. Grouped by category (technologyPage.faqCategories). Visible text
  and FAQPage/DefinedTermSet schema share one source
  (src/_data/technologyPage.js) so they cannot drift.
-#}
{%- set tp = technologyPage %}
  <main>

    <!-- HERO -->
    <section class="tech-hero tech-hero--compact">
      <div class="tech-hero-content">
        <span class="product-category">Technology FAQ</span>
        <h1 class="tech-hero-headline">Direct conversion X-ray imaging — FAQ</h1>
        <p class="tech-hero-sub">
          Answers to common questions about direct conversion, detector materials, readout, and how Athlos sensors work. For the short version, see the <a href="/technology/direct-conversion.html">Technology overview</a>.
        </p>
      </div>
    </section>

    <!-- FAQ BY CATEGORY -->
    <section class="tech-section tech-section--light" id="faq">
      <div class="container container--narrow">
{%- for cat in tp.faqCategories %}
        <div class="tech-faq-group">
          <h2 class="tech-faq-group-title reveal" id="faq-cat-{{ cat.id }}">{{ cat.label }}</h2>
          <div class="tech-faq tech-faq--light">
{%- for f in tp.faq %}{% if f.category == cat.id %}
            <div class="tech-faq-item reveal" id="faq-{{ f.id }}">
              <h3 class="tech-faq-q">{{ f.q }}</h3>
              <p class="tech-faq-a">{{ f.a }}</p>
            </div>
{%- endif %}{% endfor %}
          </div>
        </div>
{%- endfor %}
      </div>
    </section>

    <!-- GLOSSARY -->
    <section class="tech-section tech-section--dark" id="glossary">
      <div class="container">
        <div class="tech-section-head">
          <p class="section-eyebrow section-eyebrow--light reveal">Terminology</p>
          <h2 class="section-headline section-headline--light reveal">Glossary of direct conversion imaging terms</h2>
        </div>
        <dl class="tech-glossary tech-glossary--dark">
{%- for g in tp.glossary %}
          <div class="tech-glossary-card reveal" id="term-{{ g.id }}">
            <dt>{{ g.term }}</dt>
            <dd>{{ g.def }}</dd>
          </div>
{%- endfor %}
        </dl>
      </div>
    </section>

    <!-- REFERENCES -->
    <section class="tech-section tech-section--light" id="references">
      <div class="container container--narrow">
        <div class="tech-section-head">
          <p class="section-eyebrow reveal">Scientific background</p>
          <h2 class="section-headline reveal">Selected publications</h2>
          <p class="tech-lead reveal">Peer-reviewed publications by the Simage/Ajat team documenting the development of direct conversion X-ray imaging. Historical references — not descriptions of current product specifications.</p>
        </div>
        <ol class="tech-references reveal">
{%- for c in tp.citations %}
          <li>{{ c.authors }}. <em>{{ c.title }}</em>. {{ c.venue }}, {{ c.year }}.{% if c.url %} <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url }}</a>{% endif %}</li>
{%- endfor %}
        </ol>
      </div>
    </section>

    <!-- CTA -->
    <section class="product-cta" id="contact">
      <div class="container" style="text-align:center;">
        <p class="section-eyebrow section-eyebrow--light reveal">Get in Touch</p>
        <h2 class="section-headline section-headline--light reveal" style="max-width:640px;margin-left:auto;margin-right:auto;">Still have a question about direct conversion?</h2>
        <p class="reveal" style="font-size:var(--text-base);font-weight:300;line-height:1.75;color:rgba(255,255,255,0.6);max-width:560px;margin:0 auto 2rem;">
          The Athlos team can help you evaluate direct conversion detectors for your imaging system.
        </p>
        <div class="reveal" style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/contact.html" class="btn btn-primary">Contact Athlos</a>
          <a href="/technology/direct-conversion.html" class="btn btn-outline">Technology overview</a>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
