  image: https://athlos.fi/images/new_ultra-fast.webp
  imageWidth: 1792
  imageHeight: 2400
twitter:
  image: https://athlos.fi/images/new_ultra-fast.webp
stylesheets:
  - css/style.css
  - css/products.css
  - css/technology.css
nav:
  prefix: ""
navComment: NAV
