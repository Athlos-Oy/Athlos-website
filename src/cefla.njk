---
layout: layouts/base.njk
permalink: /cefla.html
lang: en
title: Cefla — UFS QA Sheet Download | Athlos
description: Cefla customer portal for downloading UFS QA sheets. Enter your invoice number to retrieve the matching QA documentation.
canonical: https://athlos.fi/cefla
stylesheets:
  - css/style.css
  - css/products.css
nav:
  prefix: ""
navComment: NAV
omitMain: true
trailingScripts: |2-

    <script>
      (function () {
        var STORAGE_KEY = 'cefla-pw';
        var INTRO_PASSWORD = 'This portal is reserved for Cefla. Enter the access password to continue.';
        var INTRO_INVOICE  = 'Enter the invoice number for your Cefla UFS delivery to retrieve the matching QA sheet.';

        var intro          = document.getElementById('cf-intro');
        var passwordForm   = document.getElementById('cf-password-form');
        var passwordInput  = document.getElementById('cf-password');
        var rememberCheck  = document.getElementById('cf-remember');
        var passwordSubmit = document.getElementById('cf-password-submit');
        var passwordError  = document.getElementById('cf-password-error');

        var invoiceForm   = document.getElementById('ceflaForm');
        var invoiceInput  = document.getElementById('cf-invoice');
        var invoiceSubmit = document.getElementById('cf-submit');
        var errorBox      = document.getElementById('cf-error');
        var resultBox     = document.getElementById('cf-result');

        var downloadLink  = document.getElementById('cf-download-link');
        var downloadLabel = document.getElementById('cf-download-label');
        var searchAnother = document.getElementById('cf-search-another');

        // Password kept in memory for the session; persisted only if the user
        // ticked "Remember me".
        var sessionPassword = '';
        try { sessionPassword = localStorage.getItem(STORAGE_KEY) || ''; } catch (e) {}

        function showInvoicePanel() {
          passwordForm.style.display = 'none';
          invoiceForm.style.display = '';
          intro.textContent = INTRO_INVOICE;
          invoiceInput.focus();
        }

        function showPasswordPanel(msg) {
          invoiceForm.style.display = 'none';
          resultBox.style.display = 'none';
          passwordForm.style.display = '';
          intro.textContent = INTRO_PASSWORD;
          passwordInput.value = '';
          if (msg) {
            passwordError.textContent = msg;
            passwordError.style.display = 'block';
          } else {
            passwordError.style.display = 'none';
          }
          passwordInput.focus();
        }

        if (sessionPassword) {
          showInvoicePanel();
        } else {
          passwordInput.focus();
        }

        function showError(msg) {
          resultBox.style.display = 'none';
          errorBox.textContent = msg;
          errorBox.style.display = 'block';
        }

        function clearMessages() {
          errorBox.style.display = 'none';
          resultBox.style.display = 'none';
        }

        function formatSize(bytes) {
          if (!bytes || isNaN(bytes)) return '';
          if (bytes < 1024) return bytes + ' B';
          if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
          return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function showResult(url, filename, size) {
          errorBox.style.display = 'none';
          downloadLink.href = url;
          downloadLink.setAttribute('download', filename);
          var sizeLabel = formatSize(size);
          downloadLabel.textContent =
            'Download ' + filename + (sizeLabel ? ' (' + sizeLabel + ')' : '');
          resultBox.style.display = 'block';
        }

        searchAnother.addEventListener('click', function (e) {
          e.preventDefault();
          clearMessages();
          invoiceInput.value = '';
          invoiceInput.focus();
        });

        passwordForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          passwordError.style.display = 'none';

          var password = passwordInput.value;
          if (!password) {
            passwordError.textContent = 'Please enter the access password.';
            passwordError.style.display = 'block';
            return;
          }

          passwordSubmit.disabled = true;
          passwordSubmit.textContent = 'Checking…';

          try {
            var response = await fetch('/api/cefla-download', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ password: password, validateOnly: true })
            });
            var data = await response.json();

            if (response.ok && data.ok) {
              sessionPassword = password;
              if (rememberCheck.checked) {
                try { localStorage.setItem(STORAGE_KEY, password); } catch (e) {}
              } else {
                try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
              }
              showInvoicePanel();
            } else {
              passwordError.textContent = data.error || 'Incorrect password.';
              passwordError.style.display = 'block';
              passwordInput.select();
            }
          } catch (err) {
            passwordError.textContent = 'Network error. Please try again.';
            passwordError.style.display = 'block';
          } finally {
            passwordSubmit.disabled = false;
            passwordSubmit.textContent = 'Continue';
          }
        });

        invoiceForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          clearMessages();

          if (!sessionPassword) {
            showPasswordPanel();
            return;
          }

          // Strip spaces, dashes, and dots — users often type "190 551" or "190-551".
          var invoice = invoiceInput.value.replace(/[\s.\-]/g, '');
          if (!invoice) {
            showError('Please enter your invoice number.');
            return;
          }

          invoiceSubmit.disabled = true;
          invoiceSubmit.textContent = 'Checking…';

          try {
            var response = await fetch('/api/cefla-download', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ invoice: invoice, password: sessionPassword })
            });
            var data = await response.json();

            if (response.status === 401) {
              // Password was rotated or invalidated server-side. Kick back to step 1.
              try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
              sessionPassword = '';
              showPasswordPanel(data.error || 'Password is no longer valid. Please enter it again.');
            } else if (response.ok && data.ok) {
              var safeName = String(data.filename).replace(/[<>"']/g, '');
              showResult(data.url, safeName, data.size);
            } else {
              showError(data.error || 'Could not retrieve QA sheet.');
            }
          } catch (err) {
            showError('Network error. Please try again.');
          } finally {
            invoiceSubmit.disabled = false;
            invoiceSubmit.textContent = 'Find QA Sheet';
          }
        });
      })();
    </script>
---
  <main style="padding-top: calc(var(--nav-h) + 48px);">
    <section style="padding: var(--section-py) 0; background: var(--white);">
      <div class="container" style="max-width: 640px;">

        <p class="section-eyebrow">Cefla Customer Portal</p>
        <h1 class="section-headline" style="font-size: var(--text-2xl); margin-bottom: 0.75rem;">Cefla — UFS QA Sheet Download</h1>
        <p id="cf-intro" style="font-size: var(--text-base); font-weight: 300; line-height: 1.8; color: var(--gray-steel); margin-bottom: 2rem;">
          This portal is reserved for Cefla. Enter the access password to continue.
        </p>

        <!-- Step 1: Password -->
        <form class="contact-form" id="cf-password-form" novalidate>
          <label for="cf-password">Access password</label>
          <input type="password" id="cf-password" name="password" placeholder="Enter access password" autocomplete="current-password" required>

          <label style="display:flex; align-items:center; gap:0.6rem; font-weight:400; color:var(--gray-steel); margin: 0.25rem 0 1rem; cursor:pointer;">
            <input type="checkbox" id="cf-remember" style="width:auto; margin:0; padding:0; -webkit-appearance:checkbox; appearance:checkbox; border:none; background:transparent;">
            <span>Remember me on this device</span>
          </label>

          <div id="cf-password-error" style="display:none; font-size:var(--text-sm); color:#c0392b; background:#fdf0ef; border:1px solid #f5c6c4; border-radius:8px; padding:0.75rem 1rem; margin-bottom:0.75rem;"></div>

          <button type="submit" id="cf-password-submit" class="btn btn-primary" style="width:100%; justify-content:center;">Continue</button>
        </form>

        <!-- Step 2: Invoice lookup -->
        <form class="contact-form" id="ceflaForm" style="display:none;" novalidate>
          <label for="cf-invoice">Invoice number</label>
          <input type="text" id="cf-invoice" name="invoice" placeholder="e.g. 12345" autocomplete="off" required>

          <div id="cf-error" style="display:none; font-size:var(--text-sm); color:#c0392b; background:#fdf0ef; border:1px solid #f5c6c4; border-radius:8px; padding:0.75rem 1rem; margin-bottom:0.75rem;"></div>

          <button type="submit" id="cf-submit" class="btn btn-primary" style="width:100%; justify-content:center;">Find QA Sheet</button>
        </form>

        <div id="cf-result" style="display:none; margin-top:1.5rem; padding:1.5rem; background:#eef9f1; border:1px solid #c7e6d2; border-radius:12px;">
          <div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1rem; color:#1b6b3a; font-size:var(--text-sm); font-weight:500;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
            <span>QA sheet found</span>
          </div>
          <a id="cf-download-link" href="#" download class="btn btn-primary" style="width:100%; justify-content:center; gap:0.6rem; text-decoration:none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span id="cf-download-label">Download</span>
          </a>
          <p style="margin: 1rem 0 0; font-size: var(--text-sm); color:#1b6b3a; text-align:center;">
            <a href="#" id="cf-search-another" style="color:#1b6b3a; text-decoration:underline;">Search another invoice</a>
          </p>
        </div>

        <p style="margin-top: 2rem; font-size: var(--text-sm); font-weight: 300; line-height: 1.7; color: var(--gray-steel);">
          Trouble finding your QA sheet? Contact <a href="mailto:info@athlos.fi">info@athlos.fi</a> with your invoice number and we will assist.
        </p>

      </div>
    </section>
  </main>

