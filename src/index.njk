---
layout: layouts/base.njk
pagination:
  data: locales.active
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{% if lang == 'en' %}/index.html{% else %}/{{ lang }}/index.html{% endif %}"
pageKey: home
og:
  type: website
  image: https://athlos.fi/images/hero-lab-automation.webp
  imageWidth: 5504
  imageHeight: 3072
twitter:
  image: https://athlos.fi/images/hero-lab-automation.webp
preloadImage: /images/hero-lab-automation.webp
includeFoucStyle: true
includeOrganizationJsonld: true
jsonldHeadPartials:
  - partials/page-jsonld/home-faq.njk
  - partials/page-jsonld/home-itemlist.njk
nav:
  prefix: ""
navComment: NAVIGATION
footerNavAriaLabel: Footer navigation
trailingScripts: '<script type="module" src="/js/conversion-experience.js"></script>'
---
    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-slideshow" aria-hidden="true">
        <div class="hero-slide active" style="background-image: url('/images/hero-lab-automation.webp')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero-cleanroom-worker.webp')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero-facility.webp')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero-process.webp')"></div>
        <div class="hero-overlay"></div>
        <div class="hero-gradient"></div>
      </div>
      <div class="hero-content">
        <p class="hero-eyebrow">{{ "pages.home.hero.eyebrow" | t }}</p>
        <h1 class="hero-headline">
          {{ "pages.home.hero.headline" | t | safe }}
        </h1>
        <p class="hero-sub">
          {{ "pages.home.hero.sub" | t }}
        </p>
        <div class="hero-actions">
          <a href="products/index.html" class="btn btn-primary">{{ "pages.home.hero.ctaProducts" | t }}</a>
          <a href="about.html" class="btn btn-outline">{{ "pages.home.hero.ctaAbout" | t }}</a>
        </div>
      </div>
      <div class="hero-indicators" aria-hidden="true">
        <button class="hero-dot active" data-index="0"></button>
        <button class="hero-dot" data-index="1"></button>
        <button class="hero-dot" data-index="2"></button>
        <button class="hero-dot" data-index="3"></button>
      </div>
      <div class="hero-scroll-cue" aria-hidden="true">
        <span class="hero-scroll-line"></span>
      </div>
    </section>

    <!-- STATEMENT -->
    <section class="statement">
      <div class="container">
        <div class="statement-inner">
          <h2 class="statement-headline reveal">
            {{ "pages.home.statement.headline" | t | safe }}
          </h2>
          <p class="statement-body reveal">
            {{ "pages.home.statement.body" | t }}
          </p>
          <div class="statement-stats reveal">
            <div class="stat-item">
              <span class="stat-number">{{ "pages.home.statement.stats.invented.number" | t }}</span>
              <span class="stat-label">{{ "pages.home.statement.stats.invented.label" | t }}</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <span class="stat-number">{{ "pages.home.statement.stats.expertise.number" | t }}</span>
              <span class="stat-label">{{ "pages.home.statement.stats.expertise.label" | t }}</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <span class="stat-number">{{ "pages.home.statement.stats.markets.number" | t }}</span>
              <span class="stat-label">{{ "pages.home.statement.stats.markets.label" | t }}</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <span class="stat-number">{{ "pages.home.statement.stats.fda.number" | t }}</span>
              <span class="stat-label">{{ "pages.home.statement.stats.fda.label" | t }}</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <span class="stat-number">{{ "pages.home.statement.stats.iso.number" | t }}</span>
              <span class="stat-label">{{ "pages.home.statement.stats.iso.label" | t }}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="technology" id="technology">
      <div class="container">
        <div class="tech-grid">
          <div class="tech-content">
            <p class="section-eyebrow reveal">{{ "pages.home.tech.eyebrow" | t }}</p>
            <h2 class="section-headline reveal">{{ "pages.home.tech.headline" | t | safe }}</h2>
            <p class="tech-body reveal">
              {{ "pages.home.tech.body1" | t }}
            </p>
            <p class="tech-body reveal">
              {{ "pages.home.tech.body2" | t }}
            </p>
          </div>
          <div class="tech-visual">
            {% include "partials/conversion-experience.njk" %}
          </div>
          <div class="tech-bottom">
            <div class="tech-features reveal">
              <div class="tech-feature">
                <span class="tech-feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ "pages.home.tech.features.cdte" | t }}
              </div>
              <div class="tech-feature">
                <span class="tech-feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ "pages.home.tech.features.cmos" | t }}
              </div>
              <div class="tech-feature">
                <span class="tech-feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ "pages.home.tech.features.photon" | t }}
              </div>
              <div class="tech-feature">
                <span class="tech-feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ "pages.home.tech.features.libs" | t }}
              </div>
            </div>
            <a href="about.html" class="btn btn-secondary reveal">{{ "pages.home.tech.learnLink" | t }} →</a>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="products" id="products">
      <div class="container">
        <div class="products-header">
          <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.home.products.eyebrow" | t }}</p>
          <h2 class="section-headline section-headline--light reveal">
            {{ "pages.home.products.headline" | t }}
          </h2>
          <p class="products-intro reveal">
            {{ "pages.home.products.intro" | t }}
          </p>
        </div>
        <div class="products-grid">

          <article class="product-card reveal">
            <div class="product-card-image">
              <img src="/images/wios-hero.webp" srcset="/images/wios-hero-480.webp 480w, /images/wios-hero-768.webp 768w, /images/wios-hero.webp 1200w" sizes="(max-width: 768px) 90vw, 600px" width="1792" height="2400" alt="{{ "pages.home.products.cards.wios.imageAlt" | t }}" loading="lazy">
            </div>
            <div class="product-card-body">
              <span class="product-market">{{ "pages.home.products.cards.wios.market" | t }}</span>
              <h3 class="product-name">{{ "pages.home.products.cards.wios.name" | t | safe }}</h3>
              <p class="product-desc">{{ "pages.home.products.cards.wios.desc" | t }}</p>
              <a href="products/wios.html" class="product-link">{{ "pages.home.products.cards.wios.link" | t | safe }} <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="product-card reveal" data-delay="80">
            <div class="product-card-image">
              <img src="/images/ufs-dark.webp" srcset="/images/ufs-dark-480.webp 480w, /images/ufs-dark-768.webp 768w, /images/ufs-dark.webp 1200w" sizes="(max-width: 768px) 90vw, 600px" width="1792" height="2400" alt="{{ "pages.home.products.cards.ufs.imageAlt" | t }}" loading="lazy">
            </div>
            <div class="product-card-body">
              <span class="product-market">{{ "pages.home.products.cards.ufs.market" | t }}</span>
              <h3 class="product-name">{{ "pages.home.products.cards.ufs.name" | t }}</h3>
              <p class="product-desc">{{ "pages.home.products.cards.ufs.desc" | t }}</p>
              <a href="products/ufs.html" class="product-link">{{ "pages.home.products.cards.ufs.link" | t }} <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="product-card reveal" data-delay="160">
            <div class="product-card-image">
              <img src="/images/ip67-carbon.webp" srcset="/images/ip67-carbon-480.webp 480w, /images/ip67-carbon-768.webp 768w, /images/ip67-carbon.webp 1200w" sizes="(max-width: 768px) 90vw, 600px" width="1792" height="2400" alt="{{ "pages.home.products.cards.ufsIp67.imageAlt" | t }}" loading="lazy">
            </div>
            <div class="product-card-body">
              <span class="product-market">{{ "pages.home.products.cards.ufsIp67.market" | t }}</span>
              <h3 class="product-name">{{ "pages.home.products.cards.ufsIp67.name" | t }}</h3>
              <p class="product-desc">{{ "pages.home.products.cards.ufsIp67.desc" | t }}</p>
              <a href="products/ufs-ip67.html" class="product-link">{{ "pages.home.products.cards.ufsIp67.link" | t }} <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="product-card reveal" data-delay="240">
            <div class="product-card-image">
              <img src="/images/manufacturing-wafer-1.webp" srcset="/images/manufacturing-wafer-1-480.webp 480w, /images/manufacturing-wafer-1-768.webp 768w, /images/manufacturing-wafer-1.webp 1200w" sizes="(max-width: 768px) 90vw, 600px" width="2400" height="1792" alt="{{ "pages.home.products.cards.manufacturing.imageAlt" | t }}" loading="lazy">
            </div>
            <div class="product-card-body">
              <span class="product-market">{{ "pages.home.products.cards.manufacturing.market" | t }}</span>
              <h3 class="product-name">{{ "pages.home.products.cards.manufacturing.name" | t }}</h3>
              <p class="product-desc">{{ "pages.home.products.cards.manufacturing.desc" | t }}</p>
              <a href="products/manufacturing.html" class="product-link">{{ "pages.home.products.cards.manufacturing.link" | t }} <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="product-card reveal" data-delay="320">
            <div class="product-card-image">
              <img src="/images/software_image_homepage.webp" srcset="/images/software_image_homepage-640.webp 640w, /images/software_image_homepage-960.webp 960w, /images/software_image_homepage-1280.webp 1280w, /images/software_image_homepage.webp 1920w" sizes="(max-width: 768px) 90vw, 600px" width="1920" height="1280" alt="{{ "pages.home.products.cards.software.imageAlt" | t }}" loading="lazy">
            </div>
            <div class="product-card-body">
              <span class="product-market">{{ "pages.home.products.cards.software.market" | t | safe }}</span>
              <h3 class="product-name">{{ "pages.home.products.cards.software.name" | t }}</h3>
              <p class="product-desc">{{ "pages.home.products.cards.software.desc" | t }}</p>
              <a href="products/software.html" class="product-link">{{ "pages.home.products.cards.software.link" | t }} <span aria-hidden="true">→</span></a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- MANUFACTURING -->
    <section class="manufacturing" id="manufacturing">
      <div class="manufacturing-image" aria-hidden="true">
        <img src="/images/hero-facility.webp" srcset="/images/hero-facility-640.webp 640w, /images/hero-facility-960.webp 960w, /images/hero-facility-1280.webp 1280w, /images/hero-facility.webp 1920w" sizes="100vw" width="1920" height="1072" alt="" loading="lazy">
        <div class="manufacturing-overlay"></div>
      </div>
      <div class="container">
        <div class="manufacturing-content">
          <p class="section-eyebrow section-eyebrow--light reveal">{{ "pages.home.manufacturing.eyebrow" | t | safe }}</p>
          <h2 class="section-headline section-headline--light reveal">
            {{ "pages.home.manufacturing.headline" | t | safe }}
          </h2>
          <p class="manufacturing-body reveal">
            {{ "pages.home.manufacturing.body" | t }}
          </p>
          <div class="manufacturing-pillars reveal">
            <div class="pillar">
              <h4 class="pillar-title">{{ "pages.home.manufacturing.pillars.cleanroom.title" | t }}</h4>
              <p class="pillar-body">{{ "pages.home.manufacturing.pillars.cleanroom.body" | t }}</p>
            </div>
            <div class="pillar">
              <h4 class="pillar-title">{{ "pages.home.manufacturing.pillars.partners.title" | t }}</h4>
              <p class="pillar-body">{{ "pages.home.manufacturing.pillars.partners.body" | t }}</p>
            </div>
            <div class="pillar">
              <h4 class="pillar-title">{{ "pages.home.manufacturing.pillars.iso.title" | t }}</h4>
              <p class="pillar-body">{{ "pages.home.manufacturing.pillars.iso.body" | t }}</p>
            </div>
          </div>
          <a href="products/manufacturing.html" class="btn btn-outline reveal">{{ "pages.home.manufacturing.cta" | t }} →</a>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="cta-section" id="contact">
      <div class="container">
        <div class="cta-inner">
          <p class="section-eyebrow reveal">{{ "pages.home.cta.eyebrow" | t }}</p>
          <h2 class="cta-headline reveal">
            {{ "pages.home.cta.headline" | t | safe }}
          </h2>
          <p class="cta-body reveal">
            {{ "pages.home.cta.body" | t }}
          </p>
          <div class="cta-actions reveal">
            <a href="contact.html" class="btn btn-primary btn-large">{{ "pages.home.cta.button" | t }}</a>
            <span class="cta-detail">{{ site.email }}</span>
          </div>
          <p class="cta-location reveal">{{ "pages.home.cta.location" | t }}</p>
        </div>
      </div>
    </section>