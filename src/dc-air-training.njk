      <h2 class="tc-guide-title" id="tcGuideTitle"></h2>
      <div class="tc-guide-body" id="tcGuideBody"></div>
      <div class="tc-guide-foot">
        <p class="tc-guide-note">Summary only — the User Q&amp;A and Troubleshooting Guide is the authoritative reference.</p>
        <a href="#" target="_blank" rel="noopener" class="btn btn-secondary" id="tcGuidePdf" data-tc-event="guide_open">Open full guide <span class="tc-support-page" id="tcGuidePdfPage"></span></a>
